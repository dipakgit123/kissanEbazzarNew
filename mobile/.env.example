# Mobile App Environment Variables

# API Configuration
# On a physical device, use your laptop/server LAN IP or deployed API URL.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.20:5000
# Leave unset to let the app try auto-detecting the Metro host IP in development.
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_PUSH_PROVIDER=firebase

# Application Configuration
EXPO_PUBLIC_APP_NAME=Kissan Ebazzar
EXPO_PUBLIC_APP_VERSION=1.0.0

# OTP Configuration
EXPO_PUBLIC_OTP_EXPIRY_MINUTES=5
EXPO_PUBLIC_OTP_RESEND_DELAY=60

# Map Configuration (Google Maps)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cloudinary Configuration (for uploads)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Socket.IO Configuration
# Example: EXPO_PUBLIC_SOCKET_URL=http://192.168.1.20:5000
EXPO_PUBLIC_SOCKET_URL=

# Features
EXPO_PUBLIC_ENABLE_BLOGS=true
EXPO_PUBLIC_ENABLE_WISHLIST=true
EXPO_PUBLIC_ENABLE_AI_HEALTH_CHECK=true
