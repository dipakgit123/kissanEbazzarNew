# Mobile App Environment Variables

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000

# Application Configuration
EXPO_PUBLIC_APP_NAME=Kissan Ebazzar
EXPO_PUBLIC_APP_VERSION=1.0.0

# OTP Configuration
EXPO_PUBLIC_OTP_EXPIRY_MINUTES=5
EXPO_PUBLIC_OTP_RESEND_DELAY=60

# Map Configuration (Google Maps)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cloudinary Configuration (for uploads)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Socket.IO Configuration
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000

# Features
EXPO_PUBLIC_ENABLE_BLOGS=true
EXPO_PUBLIC_ENABLE_WISHLIST=true
EXPO_PUBLIC_ENABLE_AI_HEALTH_CHECK=true
