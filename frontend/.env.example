# Frontend Environment Variables

# API Configuration
VITE_API_URL=http://localhost:3000

# Application Configuration
VITE_APP_NAME=Kissan Ebazzar
VITE_APP_VERSION=1.0.0

# OTP Configuration
REACT_APP_OTP_EXPIRY_MINUTES=5
REACT_APP_OTP_RESEND_DELAY=60
VITE_SUPPORT_WHATSAPP=919876543210
VITE_SUPPORT_WHATSAPP_MESSAGE=Hi! I need help with KissanEbazzar.
VITE_FACEBOOK_URL=https://facebook.com/your-page
VITE_INSTAGRAM_URL=https://instagram.com/your-handle
VITE_YOUTUBE_URL=https://youtube.com/@your-channel
VITE_TELEGRAM_URL=https://t.me/your-channel

# Features
VITE_ENABLE_BLOGS=true
VITE_ENABLE_WISHLIST=true
VITE_ENABLE_AI_HEALTH_CHECK=true

# Map Configuration (Google Maps)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cloudinary Configuration (for uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
