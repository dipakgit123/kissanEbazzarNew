NODE_ENV=production
PORT=5000

# Public application URLs
FRONTEND_URL=https://your-domain.example.com
CORS_ORIGINS=https://your-domain.example.com,https://www.your-domain.example.com

# Database
DATABASE_URL=postgresql://username:password@host:5432/database_name?sslmode=require

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# OTP provider
OTP_PROVIDER=messagecentral
OTP_LOCAL_CHANNEL=whatsapp
OTP_EXPOSE_IN_RESPONSE=false
OTP_LOCK_TIMEOUT_MS=30000

# Twilio Verify / WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_DEFAULT_CHANNEL=whatsapp
TWILIO_WHATSAPP_SENDER=whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WHATSAPP_OTP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Message Central
MESSAGE_CENTRAL_CUSTOMER_ID=your_message_central_customer_id
MESSAGE_CENTRAL_PASSWORD_KEY=your_message_central_base64_encrypted_password
# MESSAGE_CENTRAL_BASE_URL=https://cpaas.messagecentral.com
# MESSAGE_CENTRAL_FLOW_TYPE=SMS
# MESSAGE_CENTRAL_COUNTRY_CODE=91
# MESSAGE_CENTRAL_EMAIL=your-email@example.com
# MESSAGE_CENTRAL_TIMEOUT_MS=15000
# MESSAGE_CENTRAL_OTP_LENGTH=4

# Only needed when OTP_PROVIDER=messagecentral-sms
# MESSAGE_CENTRAL_SMS_SENDER_ID=YOURID
# MESSAGE_CENTRAL_SMS_MESSAGE_TYPE=TRANSACTION
# MESSAGE_CENTRAL_SMS_TYPE=SMS
# MESSAGE_CENTRAL_SMS_OTP_LENGTH=4
MESSAGE_CENTRAL_SMS_TEMPLATE=Your Kissan Ebazzar OTP is {#OTP#}. It is valid for 5 minutes.
# MESSAGE_CENTRAL_SMS_TEMPLATE_ID=
# MESSAGE_CENTRAL_SMS_ENTITY_ID=

# OTP settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
MAX_BULK_OTP=1000
BULK_OTP_BATCH_SIZE=50

# AI and geocoding
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# AWS S3
# Prefer an EC2 IAM role in production. Only set access keys here if you are not using a role.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-public-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=false

# Rate limiting / proxy
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TRUST_PROXY=1

# Optional admin bootstrap
# ADMIN_INIT_SECRET=replace-with-a-bootstrap-secret
# ADMIN_INIT_USERNAME=admin
# ADMIN_INIT_EMAIL=admin@example.com
# ADMIN_INIT_PASSWORD=replace-with-a-strong-password
# ADMIN_INIT_NAME=Super Admin

# Optional WhatsApp reactivation
# ADMIN_PHONE_NUMBER=+919999999999
