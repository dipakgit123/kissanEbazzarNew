# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (Neon PostgreSQL)
# Use DATABASE_URL for connection string format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://neondb_owner:your_password@ep-holy-art-adey58zd-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend URL
FRONTEND_URL=http://localhost:5173

# SMTP Configuration for Email Sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Twilio Configuration for production WhatsApp OTP
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_DEFAULT_CHANNEL=whatsapp
TWILIO_WHATSAPP_SENDER=whatsapp:+14155238886
# Optional legacy alias if your project still references the old variable name
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Only needed for custom non-Verify WhatsApp messaging flows
TWILIO_WHATSAPP_OTP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# OTP provider selection
# Use `twilio-verify` for the Verify API, `local` to generate OTPs locally
# and deliver them through Twilio Messaging / WhatsApp sandbox,
# `messagecentral` to send and verify OTPs through Message Central VerifyNow,
# or `messagecentral-sms` to generate OTPs locally and send a fully custom SMS body.
OTP_PROVIDER=messagecentral
OTP_LOCAL_CHANNEL=whatsapp
OTP_EXPOSE_IN_RESPONSE=false
OTP_LOCK_TIMEOUT_MS=30000

# Message Central token configuration
MESSAGE_CENTRAL_CUSTOMER_ID=your_message_central_customer_id
MESSAGE_CENTRAL_PASSWORD_KEY=your_message_central_base64_encrypted_password
# MESSAGE_CENTRAL_BASE_URL=https://cpaas.messagecentral.com

# Message Central VerifyNow configuration
# MESSAGE_CENTRAL_FLOW_TYPE=SMS
# MESSAGE_CENTRAL_COUNTRY_CODE=91
# MESSAGE_CENTRAL_EMAIL=your-email@example.com
# MESSAGE_CENTRAL_TIMEOUT_MS=15000
# MESSAGE_CENTRAL_OTP_LENGTH=4

# Message Central MessageNow custom SMS configuration
# Uncomment these only if you switch `OTP_PROVIDER` to `messagecentral-sms`.
# MESSAGE_CENTRAL_SMS_SENDER_ID=YOURID
# MESSAGE_CENTRAL_SMS_MESSAGE_TYPE=TRANSACTION
# MESSAGE_CENTRAL_SMS_TYPE=SMS
# MESSAGE_CENTRAL_SMS_OTP_LENGTH=4
MESSAGE_CENTRAL_SMS_TEMPLATE=किसान ई बाजार मध्ये आपले स्वागत आहे.\n\nआपला OTP: {#OTP#}\n\nहा OTP 5 मिनिटांसाठी वैध आहे. सुरक्षिततेसाठी तो कोणासोबतही शेअर करू नका.\n\n- किसान ई बाजार
# Optional if your approved template is not already registered with Message Central
# MESSAGE_CENTRAL_SMS_TEMPLATE_ID=
# MESSAGE_CENTRAL_SMS_ENTITY_ID=

# OTP Configuration
OTP_LENGTH=6  # Length of OTP code (default: 6)
OTP_EXPIRY_MINUTES=5  # OTP validity period (default: 5 minutes)
MAX_BULK_OTP=1000  # Maximum OTPs per bulk request (default: 1000)
BULK_OTP_BATCH_SIZE=50  # Parallel batch size for bulk OTP requests

# Cloudinary Configuration (for image/video uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Proxy trust for deployments behind a load balancer or reverse proxy.
# Use `1` for a single trusted proxy hop, leave unset/false for local development.
TRUST_PROXY=false

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:19006
